        "/api/financiamentos": {
            "get": {
                "tags": [
                    "Financiamentos"
                ],
                "summary": "Lista todos os financiamentos",
                "operationId": "listarFinanciamentos",
                "responses": {
                    "200": {
                        "description": "Lista retornada com sucesso"
                    }
                }
            },
            "post": {
                "tags": [
                    "Financiamentos"
                ],
                "summary": "Cadastrar financiamento",
                "operationId": "criarFinanciamento",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "cliente_id",
                                    "veiculo_id",
                                    "numero_contrato",
                                    "valor_veiculo",
                                    "valor_entrada",
                                    "valor_financiado",
                                    "taxa_juros",
                                    "quantidade_parcelas",
                                    "data_contratacao",
                                    "situacao"
                                ],
                                "properties": {
                                    "cliente_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "veiculo_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "numero_contrato": {
                                        "type": "string",
                                        "example": "CTR-2026-0001"
                                    },
                                    "valor_veiculo": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 80000
                                    },
                                    "valor_entrada": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 20000
                                    },
                                    "valor_financiado": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 60000
                                    },
                                    "taxa_juros": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 1.99
                                    },
                                    "quantidade_parcelas": {
                                        "type": "integer",
                                        "example": 48
                                    },
                                    "data_contratacao": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-07-20"
                                    },
                                    "situacao": {
                                        "type": "string",
                                        "example": "ATIVO"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Financiamento criado com sucesso"
                    }
                }
            }
        },
