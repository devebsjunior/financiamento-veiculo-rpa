                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/ponto/espelho/{anoMes}": {
            "get": {
                "tags": [
                    "Marcação de Ponto"
                ],
                "summary": "Consultar espelho de ponto mensal",
