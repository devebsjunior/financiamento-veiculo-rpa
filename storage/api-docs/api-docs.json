{
    "openapi": "3.0.0",
    "info": {
        "title": "API Financiamento Veículos",
        "description": "API para gerenciamento do sistema de financiamento de veículos",
        "version": "1.0.0"
    },
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Autenticar usuário",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "usuario@email.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login efetuado com sucesso"
                    },
                    "401": {
                        "description": "E-mail ou senha inválidos"
                    },
                    "403": {
                        "description": "Conta desativada"
                    }
                }
            }
        },
        "/api/clientes": {
            "get": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Lista todos os clientes",
                "operationId": "listarClientes",
                "responses": {
                    "200": {
                        "description": "Lista retornada com sucesso"
                    }
                }
            },
            "post": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Cadastrar cliente",
                "operationId": "criarCliente",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "nome",
                                    "cpf"
                                ],
                                "properties": {
                                    "nome": {
                                        "type": "string",
                                        "example": "Edson Belém"
                                    },
                                    "cpf": {
                                        "type": "string",
                                        "example": "12345678901"
                                    },
                                    "data_nascimento": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "1990-05-10"
                                    },
                                    "telefone": {
                                        "type": "string",
                                        "example": "(24)99999-9999"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "edson@gmail.com"
                                    },
                                    "cep": {
                                        "type": "string",
                                        "example": "27510000"
                                    },
                                    "logradouro": {
                                        "type": "string",
                                        "example": "Rua das Flores"
                                    },
                                    "numero": {
                                        "type": "string",
                                        "example": "123"
                                    },
                                    "bairro": {
                                        "type": "string",
                                        "example": "Centro"
                                    },
                                    "cidade": {
                                        "type": "string",
                                        "example": "Resende"
                                    },
                                    "uf": {
                                        "type": "string",
                                        "example": "RJ"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Cliente criado com sucesso"
                    }
                }
            }
        },
        "/api/clientes/{id}": {
            "get": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Buscar cliente por ID",
                "operationId": "buscarCliente",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID do cliente",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cliente encontrado"
                    },
                    "404": {
                        "description": "Cliente não encontrado"
                    }
                }
            },
            "put": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Atualizar cliente",
                "operationId": "atualizarCliente",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID do cliente",
                        "required": true
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "nome": {
                                        "type": "string",
                                        "example": "Edson Belém"
                                    },
                                    "cpf": {
                                        "type": "string",
                                        "example": "12345678901"
                                    },
                                    "data_nascimento": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "1990-05-10"
                                    },
                                    "telefone": {
                                        "type": "string",
                                        "example": "(24)99999-9999"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "edson@gmail.com"
                                    },
                                    "cep": {
                                        "type": "string",
                                        "example": "27510000"
                                    },
                                    "logradouro": {
                                        "type": "string",
                                        "example": "Rua das Flores"
                                    },
                                    "numero": {
                                        "type": "string",
                                        "example": "123"
                                    },
                                    "bairro": {
                                        "type": "string",
                                        "example": "Centro"
                                    },
                                    "cidade": {
                                        "type": "string",
                                        "example": "Resende"
                                    },
                                    "uf": {
                                        "type": "string",
                                        "example": "RJ"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Cliente atualizado com sucesso"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Clientes"
                ],
                "summary": "Excluir cliente",
                "operationId": "excluirCliente",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID do cliente",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cliente removido com sucesso"
                    }
                }
            }
        },
        "/api/financiamentos": {
            "get": {
                "tags": [
                    "Financiamentos"
                ],
                "summary": "Lista todos os financiamentos",
                "operationId": "listarFinanciamentos",
                "responses": {
                    "200": {
                        "description": "Lista retornada com sucesso"
                    }
                }
            },
            "post": {
                "tags": [
                    "Financiamentos"
                ],
                "summary": "Cadastrar financiamento",
                "operationId": "criarFinanciamento",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "cliente_id",
                                    "veiculo_id",
                                    "numero_contrato",
                                    "valor_veiculo",
                                    "valor_entrada",
                                    "valor_financiado",
                                    "taxa_juros",
                                    "quantidade_parcelas",
                                    "data_contratacao",
                                    "situacao"
                                ],
                                "properties": {
                                    "cliente_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "veiculo_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "numero_contrato": {
                                        "type": "string",
                                        "example": "CTR-2026-0001"
                                    },
                                    "valor_veiculo": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 80000
                                    },
                                    "valor_entrada": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 20000
                                    },
                                    "valor_financiado": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 60000
                                    },
                                    "taxa_juros": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 1.99
                                    },
                                    "quantidade_parcelas": {
                                        "type": "integer",
                                        "example": 48
                                    },
                                    "data_contratacao": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-07-20"
                                    },
                                    "situacao": {
                                        "type": "string",
                                        "example": "ATIVO"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Financiamento criado com sucesso"
                    }
                }
            }
        },
        "/api/financiamentos/{id}": {
            "get": {
                "tags": [
                    "Financiamentos"
                ],
                "summary": "Buscar financiamento por ID",
                "operationId": "buscarFinanciamento",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID do financiamento",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Financiamento encontrado"
                    },
                    "404": {
                        "description": "Financiamento não encontrado"
                    }
                }
            }
        },
        "/api/parcelas": {
            "get": {
                "tags": [
                    "Parcelas"
                ],
                "summary": "Lista todas as parcelas",
                "operationId": "listarParcelas",
                "responses": {
                    "200": {
                        "description": "Lista retornada com sucesso"
                    }
                }
            }
        },
        "/api/parcelas/{id}": {
            "get": {
                "tags": [
